# elan-rex com dados inventados (record.sh)
Output demo/screens.gif
Set Shell "bash"
Set FontSize 15
Set Width 1400
Set Height 640
Set Padding 18
Set Theme "Catppuccin Mocha"
Set TypingSpeed 120ms
Hide
Type "export PS1='$ ' && clear"
Enter
Type "elan-rex ui"
Enter
Sleep 3s
Show
Down
Sleep 800ms
Screenshot docs/hoje.png
Sleep 1500ms
Type "m"
Sleep 2s
Screenshot docs/reuniao.png
Sleep 1500ms
Escape
Sleep 800ms
Type "2"
Sleep 1500ms
Down
Sleep 400ms
Down
Sleep 800ms
Screenshot docs/notas.png
Sleep 1500ms
Up
Sleep 400ms
Up
Sleep 400ms
Type "cache"
Sleep 400ms
Enter
Sleep 1500ms
Down
Sleep 800ms
Screenshot docs/busca.png
Sleep 1500ms
Type "3"
Sleep 1500ms
Screenshot docs/code-tasks.png
Sleep 1500ms
Type "5"
Sleep 1500ms
Screenshot docs/pendencias.png
Sleep 1500ms
Type "q"
